# Токен від @BotFather
BOT_TOKEN=123456:ABC-DEF

# Хто має доступ: Telegram ID та ім'я, через кому (ID можна дізнатися, написавши боту — він покаже)
ALLOWED_USERS=111111111:Ярослав,222222222:Оля,333333333:Мама

TIMEZONE=Europe/Kyiv
CURRENCY=грн

# Нагадування про регулярні платежі: о котрій годині і за скільки днів до дати
REMIND_HOUR=10
REMIND_DAYS_BEFORE=2

# Google Sheets (необов'язково). Без них бот працює лише з SQLite і settings.json
SHEET_ID=
GOOGLE_CREDENTIALS=data/credentials.json

DB_PATH=data/budget.db
SETTINGS_FILE=settings.json
